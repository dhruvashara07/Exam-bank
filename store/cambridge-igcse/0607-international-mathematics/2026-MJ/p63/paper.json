515.46 231.01 515.46 224.38L515.46 182.45C515.46 175.83 510.08 170.45 503.46 170.45L31.89 170.45","stroke":"#231f20","sw":0.5},{"d":"M31.89 252.18C25.27 252.18 19.89 257.56 19.89 264.18L19.89 289.01C19.89 295.64 25.27 301.01 31.89 301.01L503.46 301.01C510.08 301.01 515.46 295.64 515.46 289.01L515.46 264.18C515.46 257.56 510.08 252.18 503.46 252.18L31.89 252.18","stroke":"#231f20","sw":0.5}],"figs":[]}],"content":[{"type":"text","tex":"Section A"},{"type":"text","tex":"Investigation Factors and multiples"},{"type":"text","tex":"You are advised to spend no more than 45 minutes on this section."},{"type":"text","tex":"In this investigation you will look at the connection between factors and multiples of numbers."},{"type":"text","tex":"A factor of a number divides into the number without leaving a remainder. A multiple of a number is in that number’s times table."},{"type":"text","tex":"Examples"},{"type":"text","tex":"Factors of 10 are \\(1, 2, 5\\) and \\(10\\quad 10 \\div 1 = 10\\) remainder \\(0\\quad 10 \\div 2 = 5\\) remainder 0 \\(10 \\div 5 = 2\\) remainder \\(0\\quad 10 \\div 10 = 1\\) remainder 0"},{"type":"text","tex":"Any other number leaves a remainder \\(10 \\div 3 = 3\\) remainder 1 so 3 is not a factor of 10"},{"type":"text","tex":"Multiples of 7 are \\(7, 14, 21, 28\\) and so on"},{"type":"text","tex":"\\(7 \\times 1 = 7\\quad 7 \\times 2 = 14\\quad 7 \\times 3 = 21\\quad 7 \\times 4 = 28\\)"}],"tex_check":"ok"}]}